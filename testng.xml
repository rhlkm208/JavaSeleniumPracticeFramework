<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite" verbose="1" parallel="tests" thread-count="2">

	<!-- ===================== -->
	<!-- Global Parameters -->
	<!-- ===================== -->
	<parameter name="browser" value="chrome" />
	<parameter name="env" value="qa" />
	<parameter name="baseUrl" value="https://example.com" />

	<!-- ===================== -->
	<!-- Listeners (Reporting / Retry / Logs) -->
	<!-- ===================== -->
	<listeners>
		<listener class-name="listeners.TestListener" />
		<listener class-name="listeners.RetryListener" />
	</listeners>

	<!-- ===================== -->
	<!-- Test 1 -->
	<!-- ===================== -->
	<test name="Smoke Tests" parallel="classes" thread-count="2">

		<!-- Override parameter for this test -->
		<parameter name="browser" value="edge" />

		<!-- Groups execution -->
		<groups>
			<run>
				<include name="smoke" />
			</run>
		</groups>

		<classes>
			<class name="tests.LoginTest">
				<methods>
					<include name="loginTest" />
				</methods>
			</class>

			<class name="tests.HomeTest" />
		</classes>
	</test>

	<!-- ===================== -->
	<!-- Test 2 -->
	<!-- ===================== -->
	<test name="Regression Tests" parallel="methods" thread-count="3">

		<groups>
			<run>
				<include name="regression" />
				<exclude name="broken" />
			</run>
		</groups>

		<classes>
			<class name="tests.CartTest" />
			<class name="tests.PaymentTest" />
		</classes>
	</test>

	<!-- ===================== -->
	<!-- Test 3 (Single Class Execution) -->
	<!-- ===================== -->
	<test name="Sanity Test">

		<classes>
			<class name="tests.ProfileTest" />
		</classes>

	</test>

</suite>